# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (no trailing slash). Enables canonical URLs, absolute Open Graph URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com). Without these, the form shows an honest "not sent" state with an email fallback.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
CONTACT_TO_EMAIL=zeshanjamil47@gmail.com

# Optional AI assistant (any OpenAI-compatible Chat Completions API). Without AI_API_KEY + AI_MODEL the assistant runs in offline mode.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_NAME=
